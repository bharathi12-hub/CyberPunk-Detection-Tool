# ─────────────────────────────────────────────────────────────
# CyberPunk Detection Tool — Backend environment configuration
#
# Copy this file to `.env` and fill in the values:
#     cp .env.example .env
#
# `.env` is gitignored and must NEVER be committed.
# ─────────────────────────────────────────────────────────────

# ---- Server ----
# Port the Express API listens on (optional, default: 3000)
PORT=3000
# Allowed CORS origin for the extension / dashboard (optional, default: *)
ALLOWED_ORIGIN=*

# ---- Datastores ----
# PostgreSQL connection string (required)
#   e.g. postgres://user:password@localhost:5432/cyberpunk
DATABASE_URL=postgres://user:password@localhost:5432/cyberpunk

# Redis connection string (required)
#   e.g. redis://localhost:6379
REDIS_URL=redis://localhost:6379

# ---- AI (Anthropic) ----
# Powers the AI risk & phishing explanations.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ---- Threat intelligence feeds (backend-only secret keys) ----
# VirusTotal            https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=
# AbuseIPDB             https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=
# Google Safe Browsing  https://developers.google.com/safe-browsing
SAFE_BROWSING_API_KEY=
